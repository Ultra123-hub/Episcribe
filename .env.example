# Copy this file to .env to override defaults (all optional).

# Point at a different Hugging Face GGUF repo/file:
# EPISCRIBE_MODEL_REPO=Janeodum/epicast-medgemma-4b-gguf
# EPISCRIBE_MODEL_FILE=medgemma-4b-epicast-Q4_K_M.gguf

# OR skip the Hub entirely and use a local .gguf file:
# EPISCRIBE_LOCAL_MODEL_PATH=C:\models\my-model.gguf

# Runtime tuning:
# EPISCRIBE_N_CTX=4096
# EPISCRIBE_N_THREADS=8
# EPISCRIBE_N_GPU_LAYERS=0

# Whisper (offline STT):
# EPISCRIBE_WHISPER_SIZE=small
# EPISCRIBE_WHISPER_DEVICE=cpu
# EPISCRIBE_WHISPER_COMPUTE=int8
